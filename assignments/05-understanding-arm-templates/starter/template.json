{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "stage",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the resources"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service Plan pricing tier"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "storageAccountName": "[take(concat('st', parameters('environment'), variables('uniqueSuffix')), 24)]",
    "appServicePlanName": "[concat('plan-', parameters('environment'), '-', variables('uniqueSuffix'))]",
    "webAppName": "[concat('app-', parameters('environment'), '-', variables('uniqueSuffix'))]"
  },
  "resources": [
    {
      "_comment": "TODO: Replace this placeholder with Task 1 (Storage Account), Task 2 (App Service Plan), and Task 3 (Web App with dependsOn)",
      "type": "",
      "apiVersion": "",
      "name": ""
    }
  ],
  "outputs": {
    "_comment": {
      "type": "string",
      "value": "TODO: Replace this placeholder with Task 4 outputs (webAppUrl and storageAccountId)"
    }
  }
}
